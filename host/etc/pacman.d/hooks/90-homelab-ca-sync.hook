[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/share/ca-certificates/trust-source/*
Target = etc/ca-certificates/trust-source/*

[Action]
Description = Copying the host CA bundle for containers...
When = PostTransaction
Exec = /usr/bin/install -D -m 0644 /etc/ca-certificates/extracted/tls-ca-bundle.pem /etc/homelab-ca/certs/ca-certificates.crt
