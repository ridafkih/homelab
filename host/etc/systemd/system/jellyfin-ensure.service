[Unit]
Description=Ensure Jellyfin container is running after boot
After=docker.service nvidia-docker-arch.service
Requires=docker.service

[Service]
Type=oneshot
# Docker does not retry containers that fail during daemon startup.
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5 6; do [ "$(docker inspect -f {{.State.Running}} jellyfin)" = true ] && exit 0; docker start jellyfin && exit 0; sleep 10; done; exit 1'

[Install]
WantedBy=multi-user.target
