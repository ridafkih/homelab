# Copy to .env (0600). Generate STORAGE_SECRET_KEY with `openssl rand -hex 32`.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=
# No sign-in, one admin user: the port is published on the tailnet IP only.
AUTH_MODE=local_noauth
# Must be https off loopback; Caddy (tls service) gets the tailnet cert for it.
BETTER_AUTH_URL=https://homelab.worm-godzilla.ts.net:3001
BIND_ADDRESS=100.100.81.126
PORT=3001
# Optional feature credentials, applied with
# `docker compose up -d --force-recreate init web crawl-gateway`.
DATAFORSEO_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTEXT_API_KEY=
