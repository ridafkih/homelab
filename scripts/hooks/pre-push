#!/bin/sh
set -eu

scanner=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd -P)/tests/exposure.sh
[ -f "$scanner" ] || { echo "pre-push: $scanner is missing" >&2; exit 1; }

denylist=$(git config --type=path --get homelab.exposureDenylist) || {
  echo "pre-push: set homelab.exposureDenylist to the denylist file kept outside the repo" >&2
  exit 1
}
[ -s "$denylist" ] || { echo "pre-push: the denylist $denylist is missing or empty" >&2; exit 1; }

work=$(mktemp -d -t pre-push.XXXXXX)
trap 'rm -rf "$work"' EXIT INT TERM

zero=0000000000000000000000000000000000000000
failed=0
while read -r _ local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue
  rm -rf "$work/tree"
  mkdir "$work/tree"
  git archive "$local_sha" | tar -x -C "$work/tree"
  sh "$scanner" --denylist "$denylist" "$work/tree" > "$work/scan" 2>&1 || {
    echo "pre-push: the tree going to $remote_ref would publish:" >&2
    cat "$work/scan" >&2
    failed=1
  }
  if [ "$remote_sha" = "$zero" ]; then
    set -- "$local_sha" --not --remotes
  else
    set -- "$remote_sha..$local_sha"
  fi
  sh "$scanner" --denylist "$denylist" --history "$@" > "$work/history" 2>&1 || {
    echo "pre-push: commits going to $remote_ref would publish:" >&2
    cat "$work/history" >&2
    failed=1
  }
done

exit "$failed"
